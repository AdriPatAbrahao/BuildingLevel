# --- Python bytecode / cache ---
__pycache__/
*.pyc
*.pyo

# --- Resultados de treino/experimentos (gerados localmente, não versionados) ---
outputs/experiments/
outputs/results/

# --- Notas/documentos internos de planejamento (Trae IDE) ---
.trae/

# --- Imagens geradas (plots, gráficos) ---
*.png
*.jpg
*.jpeg

# --- Ambiente virtual ---
.venv/
venv/

# --- Outros artefatos locais ---
*.tmp

# --- Artefatos de pilotos/testes de validação (relatórios TQS, dumps de
#     dados, figuras) — ficam no disco, não entram no controle de versão ---
outputs/validation/**/*.htm
outputs/validation/**/*.html
outputs/validation/**/*.csv
outputs/validation/**/*.json
outputs/validation/**/*.pdf
outputs/validation/**/*.log
outputs/validation/**/*.npz
outputs/validation/**/*.ndjson
outputs/validation/**/*.tmp
outputs/validation/**/*.txt
